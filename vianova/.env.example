# Copie como .env (Docker) o exporte estas variables antes de iniciar. NUNCA suba el .env con valores reales al repositorio.

# Ambiente: desarrollo | pruebas | produccion  (cada uno usa su propia base, claves y carpeta de datos)
APP_ENV=desarrollo

# Modelo de lenguaje opcional: local | anthropic | openai
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# RAG y recomendador
RAG_TAU=0.12
RAG_MIN_COVERAGE=0.34
RAG_EMBED_DIM=64
RAG_DENSE_WEIGHT=0.3
W_SEM=0.45
W_CTX=0.25
W_REG=0.20
W_PREF=0.10
ON_TIME_TOLERANCE_MIN=60

# Base de datos (producción: PostgreSQL obligatorio)
# DATABASE_URL=postgresql+psycopg://vianova:vianova@db:5432/vianova
# DB_POOL_SIZE=50
# DB_MAX_OVERFLOW=50

# Cuentas internas iniciales (en producción la app NO arranca con las contraseñas por defecto)
VIANOVA_ADMIN_EMAIL=curador@vianova.local
VIANOVA_ADMIN_PASSWORD=cambie-esta-clave
VIANOVA_RESEARCHER_EMAIL=investigador@vianova.local
VIANOVA_RESEARCHER_PASSWORD=cambie-esta-clave
VIANOVA_SYSADMIN_EMAIL=admin@vianova.local
VIANOVA_SYSADMIN_PASSWORD=cambie-esta-clave

# Secretos (obligatorios en producción; en desarrollo/pruebas se generan por ambiente)
# JWT_SECRET=
# VIANOVA_FERNET_KEY=

# Respaldos cifrados: solo nube (s3://bucket/prefijo o rclone:remoto:carpeta). Prohibido usar discos externos.
# VIANOVA_BACKUP_DEST=s3://bucket-institucional/vianova
# VIANOVA_BACKUP_KEY=
# VIANOVA_BACKUP_RETENTION=14
