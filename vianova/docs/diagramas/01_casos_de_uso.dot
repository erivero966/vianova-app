digraph CU { rankdir=LR; fontname="DejaVu Sans"; node [fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9]; nodesep=0.18; ranksep=1.3; splines=true;
"Cuidador" [shape=none, image="", label="☺\nCuidador", fontsize=13];
"Curador" [shape=none, image="", label="☺\nCurador", fontsize=13];
"Administrador" [shape=none, image="", label="☺\nAdministrador", fontsize=13];
"Investigador" [shape=none, image="", label="☺\nInvestigador", fontsize=13];
subgraph cluster_s { label="Aplicación móvil Vianova"; style="rounded"; color="#0f6b5c"; fontsize=14; penwidth=2;
CU01 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU01: Crear cuenta, perfil\ny consentimiento\n(RF-01)", fontsize=10];
CU02 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU02: Gestionar agenda\nde cuidado\n(RF-02)", fontsize=10];
