CU05 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU05: Consultar\nrecomendaciones\n(RF-05)", fontsize=10];
CU06 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU06: Consultar al\nasistente (RAG)\n(RF-06)", fontsize=10];
CU07 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU07: Ver fuente y\ntraza\n(RF-07)", fontsize=10];
CU08 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU08: Valorar\nrecomendación\n(RF-08)", fontsize=10];
CU09 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU09: Revisar\navisos\n(RF-09)", fontsize=10];
CU10 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU10: Exportar\nresumen\n(RF-10)", fontsize=10];
CU11 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU11: Importar datos\nde wearable\n(RF-11)", fontsize=10];
CU15 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU15: Ejercer derechos\nARCO\n(RF-15)", fontsize=10];
CU12 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU12: Administrar corpus\ny configuración\n(RF-12)", fontsize=10];
