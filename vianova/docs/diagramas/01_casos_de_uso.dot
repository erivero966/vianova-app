CU14 [shape=ellipse, style=filled, fillcolor="#e3f1ed", color="#0f6b5c", label="CU14: Ver indicadores y\nvalidación; exportar\n(RF-14)", fontsize=10];
}
"Proveedor LLM\n(opcional)" [shape=box, style="rounded,dashed", fontsize=10];
"Reloj/pulsera" [shape=box, style="rounded,dashed", fontsize=10];
"Cuidador" -> CU01 [arrowhead=none];
"Cuidador" -> CU02 [arrowhead=none];
"Cuidador" -> CU03 [arrowhead=none];
"Cuidador" -> CU04 [arrowhead=none];
