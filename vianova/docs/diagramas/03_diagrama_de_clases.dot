digraph CL { rankdir=TB; fontname="DejaVu Sans"; node [fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9]; ranksep=0.7; nodesep=0.4;
Usuario [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>Usuario</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- código: str</font><br/><font point-size="9">- correo: str</font><br/><font point-size="9">- rol: Rol</font><br/><font point-size="9">- activo: bool</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ autenticar()</font></td></tr></table>>];
Consentimiento [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>Consentimiento</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- tipo: str</font><br/><font point-size="9">- versión: str</font><br/><font point-size="9">- otorgado: bool</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ revocar()</font></td></tr></table>>];
PerfilPaciente [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>PerfilPaciente</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- tipoCáncer: str</font><br/><font point-size="9">- tratamientos: list</font><br/><font point-size="9">- movilidad: str</font><br/><font point-size="9">- preferencia: str</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
Tarea [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>Tarea</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- tipo: medicamento|cita|actividad</font><br/><font point-size="9">- inicio: datetime</font><br/><font point-size="9">- recurrencia: str</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ ocurrencias(desde, hasta)</font></td></tr></table>>];
Cumplimiento [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>Cumplimiento</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- ocurrencia: datetime</font><br/><font point-size="9">- estado: hecha|omitida</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
RegistroCuidado [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>RegistroCuidado</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- síntoma: str</font><br/><font point-size="9">- intensidad: int</font><br/><font point-size="9">- valor: float</font><br/><font point-size="9">- textoCifrado: str</font><br/><font point-size="9">- canal: str</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
Aviso [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>Aviso</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- regla: str</font><br/><font point-size="9">- mensaje: str</font><br/><font point-size="9">- revisado: bool</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
Documento [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>Documento</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- institución: str</font><br/><font point-size="9">- versión: str</font><br/><font point-size="9">- estado: incluido|excluido|retirado</font><br/><font point-size="9">- criterios: dict</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ fragmentar()</font></td></tr></table>>];
Fragmento [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>Fragmento</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- sección: str</font><br/><font point-size="9">- texto: str</font><br/><font point-size="9">- embedding: vector</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
Retroalimentación [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>Retroalimentación</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- útil: bool</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
LecturaDispositivo [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e3f1ed"><b>LecturaDispositivo</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- métrica: str</font><br/><font point-size="9">- valor: float</font><br/><font point-size="9">- fecha: datetime</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
RegistroUso [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#fff4e0"><b>RegistroUso «Tabla 8»</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- tipoEvento</font><br/><font point-size="9">- módulo</font><br/><font point-size="9">- resultado</font><br/><font point-size="9">- fuenteId</font><br/><font point-size="9">- versiónCorpus</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
Auditoría [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#fff4e0"><b>Auditoría</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- acción: str</font><br/><font point-size="9">- detalle: str</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
IndiceHíbrido [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#eef0ff"><b>IndiceHíbrido «servicio»</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- tfidf, embeddingsLSA</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ construir()</font><br/><font point-size="9">+ buscar(consulta, k)</font><br/><font point-size="9">+ corregir(consulta)</font></td></tr></table>>];
AsistenteRAG [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#eef0ff"><b>AsistenteRAG «servicio»</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- τ, coberturaMínima</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ preguntar(consulta): Respuesta</font><br/><font point-size="9">- verificarAlcance()</font><br/><font point-size="9">- generar()</font></td></tr></table>>];
Recomendador [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#eef0ff"><b>Recomendador «servicio»</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- w1..w4</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ recomendar(usuario, consulta)</font></td></tr></table>>];
MotorAvisos [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#eef0ff"><b>MotorAvisos «servicio»</b></td></tr><tr><td align="left" balign="left"><font point-size="9">- reglas.json</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ evaluar(registro): Aviso[]</font></td></tr></table>>];
Usuario -> Consentimiento [arrowhead=none, taillabel="1", headlabel="1..*"];
Usuario -> PerfilPaciente [arrowtail=diamond, dir=back, taillabel="1", headlabel="1"];
Usuario -> Tarea [arrowtail=diamond, dir=back, taillabel="1", headlabel="*"];
Tarea -> Cumplimiento [arrowtail=diamond, dir=back, taillabel="1", headlabel="*"];
Usuario -> RegistroCuidado [arrowtail=diamond, dir=back, taillabel="1", headlabel="*"];
RegistroCuidado -> Aviso [arrowhead=none, taillabel="1", headlabel="0..*"];
Aviso -> Documento [arrowhead=vee, label="cita"];
Documento -> Fragmento [arrowtail=diamond, dir=back, taillabel="1", headlabel="1..*"];
Usuario -> Retroalimentación [arrowhead=none, taillabel="1", headlabel="*"];
Retroalimentación -> Documento [arrowhead=vee];
Usuario -> LecturaDispositivo [arrowhead=none, taillabel="1", headlabel="*"];
Usuario -> RegistroUso [arrowhead=none, style=dashed, label="seudónimo"];
IndiceHíbrido -> Fragmento [style=dashed, arrowhead=vee, label="indexa"];
AsistenteRAG -> IndiceHíbrido [style=dashed, arrowhead=vee, label="usa"];
Recomendador -> IndiceHíbrido [style=dashed, arrowhead=vee, label="usa"];
MotorAvisos -> Aviso [style=dashed, arrowhead=vee, label="crea"];
}